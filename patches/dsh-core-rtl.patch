+/* Bidi: blocks carry dir="auto" from the renderer, so alignment must follow the
+   block's own direction instead of an inherited left/right. `start` resolves to
+   the right edge for an Arabic paragraph and the left edge for an English one. */
+.markdown :where(p, h1, h2, h3, h4, h5, h6, li, blockquote, td, th) {
+  text-align: start;
+}
+
+/* Code is authored left-to-right whatever surrounds it: keep source lines and
+   their indentation readable inside Arabic prose, and isolate them so a code
+   token neither reorders the sentence nor picks up its direction. */
+.markdown pre {
+  direction: ltr;
+  unicode-bidi: isolate;
+  text-align: left;
+}
+
+.markdown :not(pre) > code {
+  direction: ltr;
+  unicode-bidi: isolate;
+}
+
+/* Arabic script needs a taller line box than Latin at the same size: harakat sit
+   above the letter and the connected baseline runs deeper, so a Latin line-height
+   lets one line's marks collide with the line above. :dir(rtl) matches blocks
+   whose dir="auto" resolved to right-to-left, leaving English copy untouched. */
+.markdown :where(p, li, blockquote, td, th):dir(rtl) {
+  line-height: 1.85;
+}
+
+.markdown.compact :where(p, li, td, th):dir(rtl) {
+  line-height: 1.75;
+}
+
