{
  "name": "dsh-plugin-arabic-locale",
  "version": "1.0.0",
  "description": "Arabic (right-to-left) language pack for the DeepSeek Harness Web UI",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "arabic",
    "rtl",
    "i18n",
    "locale"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "patches"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tigercode20/dsh-plugin-arabic-locale.git"
  },
  "homepage": "https://github.com/Tigercode20/dsh-plugin-arabic-locale#readme",
  "bugs": {
    "url": "https://github.com/Tigercode20/dsh-plugin-arabic-locale/issues"
  },
  "author": "Tigercode20"
}
